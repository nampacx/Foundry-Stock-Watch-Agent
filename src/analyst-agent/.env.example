# Local development only (copy to .env).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-luna
STORAGE_ACCOUNT_NAME=<storage account name from `azd env get-values`>
COMPANIES_TABLE=companies
COMPANIES_PARTITION=watchlist
REPORTS_CONTAINER=analyst-reports
MAX_PARALLEL_COMPANIES=3
ASPNETCORE_URLS=http://+:8088
# Skip the managed-identity probe locally.
AZURE_TOKEN_CREDENTIALS=dev
