# Local development only (copy to .env).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-luna
STORAGE_ACCOUNT_NAME=<storage account name from `azd env get-values`>
WATCHLIST_TABLE=watchlist
WATCHLIST_PARTITION=stocks
REPORTS_TABLE=reports
MAX_PARALLEL_COMPANIES=1
# Optional: send telemetry to Application Insights (azd env get-values shows it after provisioning).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
ASPNETCORE_URLS=http://+:8088
# Skip the managed-identity probe locally.
AZURE_TOKEN_CREDENTIALS=dev
